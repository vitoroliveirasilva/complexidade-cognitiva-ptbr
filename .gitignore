# Bytecode / caches Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Build / distribuição
build/
dist/
*.egg-info/
.eggs/

# Configurações locais e segredos
.env
.env.*
!.env.example
*.local

# Logs e temporários
*.log
.cache/
temp/
tmp/

# IDEs e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Dados brutos
# O dataset final é gerado localmente a partir das fontes públicas em external/public_domain_sources.csv
data/raw/*
!data/raw/.gitkeep

# Dados externos
# Apenas o catálogo de fontes públicas usado para reproduzir o dataset é versionado
data/external/*
!data/external/.gitkeep
!data/external/public_domain_sources.csv

# Textos baixados das fontes públicas
# São reproduzíveis via script e não versionados
data/external/public_domain_texts/

# Dados intermediários/processados gerados localmente
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/features/
data/processed/features/*
!data/processed/features/.gitkeep

# Artefatos gerados pelo pipeline
outputs/models/*
!outputs/models/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/runs/*
!outputs/runs/.gitkeep
outputs/latest/*
!outputs/latest/.gitkeep
outputs/ci_smoke/*


# Modelos e binários pesados gerados localmente
*.joblib
*.pkl
*.pickle
*.h5
*.pt
*.pth
*.onnx

# Arquivos tabulares grandes gerados localmente
*.parquet
*.feather
*.arrow
